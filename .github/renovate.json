{
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "commitMessagePrefix": "⬆️  "
    },
    {
      "matchManagers": ["cargo"],
      "commitMessagePrefix": "⬆️  ",
      "commitMessageTopic": "{{depName}}",
      "lockFileMaintenance": { "enabled": true }
    },
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "rebaseWhen": "conflicted"
    },
    {
      "description": [
        "The container that the walltime benchmarks are built in stays on the release of Ubuntu",
        "of the CodSpeed macro runner that runs them: built on a later one, they are linked",
        "against a later glibc, whose symbols the macro runner lacks."
      ],
      "matchFileNames": [".github/workflows/bench.yml"],
      "matchDepTypes": ["container"],
      "matchDepNames": ["ubuntu"],
      "enabled": false
    }
  ]
}
